# Symmetric key used to encrypt stored application data at rest.
# Replace this before deployment and keep it consistent across restarts.
ENCRYPTION_KEY=showcase-dashboard-encryption-key-2026

# Shared secret required by api.php for authenticated requests.
# Send it with the X-API-Key header or Authorization: Bearer <key>.
API_KEY=local-dev-api-key-change-me

# Application mode.
# Options: demo, production.
# demo resets data on index load by default; production preserves data by default.
APP_MODE=demo

# Whether visiting index.php should reset the seeded demo data.
# Options: true, false.
# If omitted, the default is true in demo mode and false in production mode.
RESET_ON_INDEX_VISIT=true

# Storage backend selector.
# Options: json, sql.
STORAGE_DRIVER=json

# SQL driver name reserved for the database-backed implementation.
# Current default: mysql.
DB_CONNECTION=mysql

# SQL server hostname or IP address.
DB_HOST=127.0.0.1

# SQL server port.
DB_PORT=3306

# Database/schema name
DB_DATABASE=test_dashboard

# Database login username.
DB_USERNAME=root

# Database login password.
DB_PASSWORD=

# Character set for the SQL connection.
# Recommended: utf8mb4.
DB_CHARSET=utf8mb4

